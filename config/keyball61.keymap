#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// マウスキーを押したらタイムアウトを延長（ドラッグやダブルクリックを考慮 1秒）
// Note: temp-layer は「指定レイヤーを一時的に有効化→解除時に無効化」なので、
// ここはマウスレイヤー（このキーマップでは index=3）を延長対象にする。

&mkp_input_listener { input-processors = <&zip_temp_layer 3 1000>; };

&lt {
    tapping-term-ms = <185>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <175>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        eisu_macwin {
            bindings = <&eisu 0 LANGUAGE_2>;
            key-positions = <28 27>;
            require-prior-idle-ms = <40>;
            layers = <0 1 3>;
        };

        kana_mac {
            bindings = <&mt RG(RS(R)) LANGUAGE_1>;
            key-positions = <31 32>;
            require-prior-idle-ms = <40>;
            layers = <0 3>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <40 39>;
        };

        period {
            bindings = <&kp PERIOD>;
            key-positions = <45 46>;
        };

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <14 13>;
        };

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <21 22>;
        };

        symbol_layer {
            bindings = <&mo 6>;
            key-positions = <55 52>;
            timeout-ms = <80>;
            require-prior-idle-ms = <175>;
        };

        close {
            bindings = <&kp LC(W)>;
            key-positions = <16 14>;
        };

        reload {
            bindings = <&kp LC(R)>;
            key-positions = <19 21>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <39 38>;
        };

        kana_win {
            bindings = <&mt RG(SLASH) LANGUAGE_1>;
            key-positions = <31 32>;
            require-prior-idle-ms = <40>;
            layers = <1>;
        };

        kana_chrome {
            bindings = <&mt LC(SPACE) INT_HENKAN>;
            key-positions = <31 32>;
            require-prior-idle-ms = <40>;
            layers = <2>;
        };

        eisu_chrome {
            bindings = <&eisu 0 RC(SPACE)>;
            key-positions = <28 27>;
            require-prior-idle-ms = <40>;
            layers = <2>;
        };
    };

    behaviors {
        hyphen_underscore_tilda_equal: hyphen_underscore_tilda_equal {
            compatible = "zmk,behavior-tap-dance";
            label = "HYPHEN_UNDERSCORE_TILDA_EQUAL";
            #binding-cells = <0>;
            bindings = <&mt TILDE MINUS>, <&mt UNDERSCORE EQUAL>;

            tapping-term-ms = <180>;
        };

        quotations_number: quotations_number {
            compatible = "zmk,behavior-tap-dance";
            label = "QUOTATIONS_NUMBER";
            #binding-cells = <0>;
            bindings = <&mt DOUBLE_QUOTES SINGLE_QUOTE>, <&mt PIPE GRAVE>;

            tapping-term-ms = <180>;
        };

        editor_2D_selectio: editor_2D_selectio {
            compatible = "zmk,behavior-tap-dance";
            label = "EDITOR_2D_SELECTIO";
            #binding-cells = <0>;
            bindings = <&mt LC(D) L>, <&mt LC(A) M>;

            tapping-term-ms = <175>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            require-prior-idle-ms = <180>;
            retro-tap;
        };

        hl: homerow_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            require-prior-idle-ms = <180>;
            retro-tap;
        };

        ctrl_spc_to_meta: ctrl_spc_to_meta {
            compatible = "zmk,behavior-mod-morph";
            label = "CTRL_SPC_TO_META";
            bindings = <&kp SPACE>, <&kp LEFT_GUI>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        ht_cb_space: ht_cb_space {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_CB_SPACE";
            bindings = <&mo>, <&ctrl_spc_to_meta>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        eisu: eisu {
            compatible = "zmk,behavior-hold-tap";
            label = "EISU";
            bindings = <&to_alphabet_then_enter>, <&kp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <220>;
        };
    };

    macros {
        switch_mac: switch_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "SWITCH_MAC";
        };

        switch_win: switch_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "SWITCH_WIN";
        };

        switch_ipad: switch_iPad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 0>;
            label = "SWITCH_IPAD";
        };

        switch_chromebook: switch_chromebook {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 2>;
            label = "SWITCH_CHROMEBOOK";
        };

        switch_mac2: switch_mac2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 0>;
            label = "SWITCH_MAC2";
        };

        to_alphabet_then_enter: to_alphabet_then_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F10>, <&macro_wait_time 5>, <&kp ENTER>;

            label = "TO_ALPHABET_THEN_ENTER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_mac {
            label = "MAC";
            bindings = <
&mt F24 LESS_THAN          &mt F1 C_MUTE     &mt F2 C_PLAY_PAUSE  &mt LEFT_BRACE LEFT_BRACKET  &mt RIGHT_BRACE RIGHT_BRACKET  &mt F5 C_PREV                                                         &mt F6 C_NEXT             &mt LESS_THAN LEFT_PARENTHESIS  &mt GREATER_THAN RIGHT_PARENTHESIS  &mt F9 C_VOLUME_DOWN  &mt F10 C_VOLUME_UP  &kp DELETE
&mt LC(LA(DELETE)) ESCAPE  &kp Q             &kp L                &kp U                        &kp F                          &mt SEMI COLON                                                        &mt QUESTION EXCLAMATION  &kp W                           &kp R                               &kp Y                 &mt EQUAL PLUS       &mt LG(H) PRINTSCREEN
&hl 4 TAB                  &hl 4 E           &hm LCTRL I          &hm LEFT_ALT A               &hm LEFT_SHIFT O               &hyphen_underscore_tilda_equal                                        &kp K                     &hm RIGHT_SHIFT T               &hm RIGHT_ALT N                     &hm RCTRL S           &kp H                &kp P
&mt LC(S) LC(V)            &mt LEFT_SHIFT Z  &mt LEFT_ALT X       &kp C                        &kp V                          &quotations_number              &mt LC(S) LC(V)  &mt LC(LS(Z)) LC(Z)  &kp G                     &kp D                           &kp M                               &mt RIGHT_ALT J       &hm RIGHT_SHIFT B    &mt BACKSLASH SLASH
&mt LC(LS(Z)) LC(Z)        &tog 6                                                                                             &mt LCTRL ENTER                 &mt LC(X) LC(C)  &mt RC(S) RC(V)      &lt 4 SPACE               &mt RIGHT_SHIFT BACKSPACE       &kp RIGHT_ALT                       &kp RIGHT_GUI         &kp LEFT_SHIFT       &lt 6 RG(TAB)
            >;
        };

        default_win {
            label = "WIN";
            bindings = <
&trans     &trans   &trans  &trans  &trans  &trans                  &trans       &trans  &trans  &trans  &trans  &trans
&trans     &trans   &trans  &trans  &trans  &trans                  &trans       &trans  &trans  &trans  &trans  &trans
&lt 5 TAB  &lt 5 E  &trans  &trans  &trans  &trans                  &trans       &trans  &trans  &trans  &trans  &trans
&trans     &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans
&trans     &trans                           &trans  &trans  &trans  &lt 5 SPACE  &trans  &trans  &trans  &trans  &trans
            >;
        };

        chromebook {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans            &trans  &trans  &trans  &trans  &mt LG(D) LG(F5)
&trans  &trans  &trans  &trans  &trans  &trans                  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans                          &trans  &trans  &trans  &ht_cb_space 5 0  &trans  &trans  &trans  &trans  &trans
            >;

            label = "CHROME";
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &switch_mac  &switch_win  &switch_ipad  &switch_chromebook  &switch_mac2                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans       &trans       &trans        &trans              &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB3     &trans       &mkp MB2      &mkp MB1            &mkp MB3                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans       &trans       &trans        &trans              &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                                                      &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        scroll_num_bt_layer-mac {
            label = "SCROLL_NUM Mac";
            bindings = <
&trans       &switch_mac   &switch_win          &switch_ipad    &switch_chromebook      &switch_mac2                   &trans      &trans        &trans        &trans        &trans    &bt BT_CLR
&trans       &mkp MB4      &trans               &kp UP_ARROW    &mt LG(HOME) LG(PG_UP)  &kp LC(R)                      &trans      &kp N7        &kp N8        &kp N9        &mkp MB5  &trans
&trans       &kp LC(LEFT)  &kp LEFT_ARROW       &kp DOWN_ARROW  &kp RIGHT               &kp LC(RIGHT)                  &trans      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans    &trans
&trans       &kp LG(LEFT)  &kp LG(RIGHT_ARROW)  &trans          &mt LG(END) LG(PG_DN)   &trans         &trans  &trans  &kp PERIOD  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0    &trans
&bootloader  &trans                                                                     &mo 6          &trans  &trans  &trans      &trans        &trans        &trans        &trans    &bootloader
            >;
        };

        scroll_num_bt_layer-win {
            label = "SCROLL_NUM Win";
            bindings = <
&trans       &switch_mac   &switch_win     &switch_ipad    &switch_chromebook      &switch_mac2                   &trans      &trans        &trans        &trans        &trans    &bt BT_CLR
&trans       &mkp MB4      &trans          &kp UP_ARROW    &mt LC(HOME) LC(PG_UP)  &kp LC(R)                      &trans      &kp N7        &kp N8        &kp N9        &mkp MB5  &trans
&trans       &kp LC(LEFT)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT               &kp LC(RIGHT)                  &trans      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans    &trans
&trans       &trans        &trans          &trans          &mt LC(END) LC(PG_DN)   &trans         &trans  &trans  &kp PERIOD  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0    &trans
&bootloader  &trans                                                                &mo 6          &trans  &trans  &trans      &trans        &trans        &trans        &trans    &bootloader
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp LS(LC(LA(DEL)))  &kp F1     &kp F2    &kp F3         &kp F4                          &kp F5                                          &kp F6                              &kp F7                              &kp F8            &kp F9         &kp F10        &kp F11
&trans               &trans     &trans    &kp LESS_THAN  &mt LESS_THAN LEFT_PARENTHESIS  &kp LESS_THAN                                   &kp GREATER_THAN                    &mt GREATER_THAN RIGHT_PARENTHESIS  &kp GREATER_THAN  &kp BACKSLASH  &trans         &trans
&trans               &kp EQUAL  &kp PIPE  &kp AT_SIGN    &mt LEFT_BRACE LEFT_BRACKET     &mt LESS_THAN LEFT_PARENTHESIS                  &mt GREATER_THAN RIGHT_PARENTHESIS  &mt RIGHT_BRACE RIGHT_BRACKET       &kp AMPERSAND     &kp ASTERISK   &kp HASH       &kp PERCENT
&trans               &trans     &trans    &kp CARET      &trans                          &trans                          &trans  &trans  &trans                              &kp DOLLAR                          &trans            &trans         &kp BACKSLASH  &trans
&trans               &trans                                                              &trans                          &trans  &trans  &trans                              &trans                              &trans            &trans         &trans         &trans
            >;
        };
    };
};
